  "item_schema_definition": {
    "field_descriptions": {
      "slug": {
        "type": "string",
        "required": true,
        "description": "品牌/商户稳定唯一的全局标识符（小写英数，连字符分隔），用于历史记录、日志索引、资源寻址"
      },
      "title": {
        "type": "string",
        "required": true,
        "description": "商户官方标准全称（用于卡片主标题与通知栏权威展示）"
      },
      "short_name": {
        "type": "string",
        "required": false,
        "description": "极简日常口语简称（如 Manner, 12306, 麦当劳）"
      },
      "badge_text": {
        "type": "string",
        "required": false,
        "description": "1~2个汉字或英文单字徽标（用于未下载或离线时快速渲染高辨识度的彩色圆形 Text Avatar 图标）"
      },
      "category": {
        "type": "string",
        "required": true,
        "description": "一级主业态分类：drink | food | express | travel | flight | supermarket | other"
      },
      "sub_category": {
        "type": "string",
        "required": false,
        "description": "二级细分业态分类：如 milk_tea, coffee, cha_chaan_teng, street_food, locker, train, airline 等"
      },
      "color": {
        "type": "string",
        "required": true,
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "description": "品牌主题 HEX 十六进制代表色，用于卡片强调条、圆形徽标底色与通知背景"
      },
      "aliases": {
        "type": "array<string>",
        "required": false,
        "description": "识别别名全集（英文全称、小写缩写、历史旧称、常见错别字等）"
      },
      "keywords": {
        "type": "array<string>",
        "required": true,
        "description": "强特征匹配词列表（特定口令、招牌产品、专有用语，如'啡快口令'、'雪王'、'葫芦'、'取件码'、'检票口'等），按长度降序优先匹配"
      },
      "package_hints": {
        "type": "array<string>",
        "required": false,
        "description": "关联移动客户端 Android/iOS 包名列表，用于通过捕获通知的来源应用实现精准命中"
      },
      "icon_url": {
        "type": "string",
        "required": false,
        "description": "官方直链或自建静态托管的高清 SVG/PNG 图标地址"
      },
      "domain": {
        "type": "string",
        "required": false,
        "description": "可选备用：官方主域名（仅作为国际 CDN 垫底可选参数，严禁强求或生造）"
      },
      "forces_pickup_scene": {
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "命中后是否强制按取件/取餐/出票卡片与超级岛/LiveActivity 模板流转"
      },
      "special_rules": {
        "type": "object",
        "required": false,
        "properties": {
          "qr_pattern": "专属二维码核销特征正则",
          "code_patterns": "专属取件码/取餐号正则规则列表",
          "require_qr_code": "是否强制要求携带二维码才视为有效凭证"
        }
      },
      "pickup_schemes": {
        "type": "array<string>",
        "required": false,
        "description": "专属取件条码/卡包页 Deep Link 或 Scheme 候选列表（按优先级尝试，直接进入对应 App 专属取件页）"
      },
      "supports_identity_code": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "品牌是否支持自提身份码/专属核销码（如菜鸟身份码、拼多多提货码）"
      },
      "identity_rules": {
        "type": "object",
        "required": false,
        "description": "身份码专用核销规则、识别特征模式及扫码呈现参数"
      },
      "custom_metadata": {
        "type": "object",
        "required": false,
        "description": "供自动化抓取脚本写入的商户扩展字段（如营业时间、热线、来源数据库 ID 等）"
      }
    },

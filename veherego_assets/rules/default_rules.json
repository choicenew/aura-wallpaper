{
  "schema_version": 2,
  "type": "pickup_code",
  "app_version": "26.9.4",
  "updated_at": "2026-09-04T00:00:00Z",
  "jsonpackage": "com.veherego.rules",
  "description": "VehereGo built-in default recognition rules (language-neutral base)",
  "brands": {
    "drink": [],
    "food": [],
    "express": []
  },
  "code_extraction": {
    "express": {
      "trigger_keywords": [],
      "hint_keywords": [],
      "patterns": [
        {
          "id": "express_locker_box_segment",
          "regex": "([A-Za-z]?\\d{1,2}[-－]\\d{1,2}[-－]\\d{3,6})",
          "priority": 1,
          "description": "Universal locker multi-segment pattern",
          "weight_multiplier": 20
        },
        {
          "id": "express_3segment",
          "regex": "([A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+)",
          "priority": 1,
          "description": "Universal 3-segment code",
          "weight_multiplier": 20
        },
        {
          "id": "express_pure_digits_4to8",
          "regex": "\\b(\\d{4,8})\\b",
          "priority": 2,
          "description": "Universal pure digits 4-8",
          "weight_multiplier": 1
        },
        {
          "id": "express_alnum_code",
          "regex": "\\b([A-Za-z0-9]{5,12})\\b",
          "priority": 3,
          "description": "Universal alphanumeric code",
          "weight_multiplier": 1
        }
      ]
    },
    "food": {
      "trigger_keywords": [],
      "hint_keywords": [],
      "patterns": [
        {
          "id": "food_letter_digits",
          "regex": "\\b([A-Za-z]\\d{2,4})\\b",
          "priority": 1,
          "description": "Universal letter plus digits order code",
          "weight_multiplier": 10
        },
        {
          "id": "food_pure_digits_3to4",
          "regex": "\\b(\\d{3,4})\\b",
          "priority": 2,
          "description": "Universal 3-4 digit queue number",
          "weight_multiplier": 5
        }
      ]
    },
    "multi_clusters": {
      "cluster_patterns": [
        "(?:pickup|code|pin)[\\s:]*([A-Za-z0-9-]{3,20}(?:\\s*[,;\\s]\\s*[A-Za-z0-9-]{3,20})*)"
      ],
      "by_patterns": [
        "(?:code|pin)\\s*([A-Za-z0-9-]{3,15})"
      ]
    }
  },
  "category_detection": {
    "default_category": "food",
    "drink_triggers": {
      "brand_based": true,
      "text_keywords": []
    },
    "ticket_triggers": {
      "text_keywords": []
    },
    "express_triggers": {
      "text_keywords": [],
      "brand_in_text": true
    }
  },
  "homepage_detection": {
    "threshold": 3,
    "keywords": []
  },
  "text_cleaning": {
    "corrections": [],
    "char_removals": [
      "|"
    ],
    "space_collapse": "(?<=[\\p{L}\\p{N}-])\\s+(?=[\\p{L}])",
    "trailing_punctuation": "[,，。！!?;？;|\\s]+$"
  },
  "validation": {
    "express_code": {
      "max_length": 12,
      "max_reverse_distance": 80,
      "max_code_keyword_gap": 30,
      "code_separators": [",", " "],
      "reject_all_letters": true,
      "reject_phone_pattern": "^1\\d{10}$",
      "reject_year_prefix": "202",
      "reject_year_length": 4,
      "reject_date_pattern": "^(?:(?:19|20)\\d{2}[-/.](?:0?[1-9]|1[0-2])[-/.](?:0?[1-9]|[12]\\d|3[01])(?:[01]\\d|2[0-3])?|(?:0?[1-9]|1[0-2])[-/.](?:0?[1-9]|[12]\\d|3[01]))$",
      "reject_time_contexts": [":", "/"],
      "reject_time_keywords": [],
      "phone_tail": {
        "length": 4,
        "digits_only": true,
        "mask_pattern": "\\*{2,}",
        "context_keywords": []
      },
      "three_segment": {
        "pattern": "([A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+)",
        "last_segment_length": 4,
        "last_segment_pattern": "[0-9]{4}",
        "description": "Universal 3-segment code validation"
      }
    },
    "food_code": {
      "reject_year_prefix": "202",
      "reject_year_length": 4,
      "reject_time_contexts": [
        ":",
        "/"
      ],
      "reject_time_keywords": [],
      "reject_patterns": [
        "^\\d+\\.\\d{1,2}$",
        "^\\d{2,3}\\.\\d{4,}$",
        "^\\d{16,}$"
      ],
      "distraction_words": [
        "ml",
        "g"
      ],
      "distraction_range": 2
    }
  },
  "recognition_params": {
    "pattern_priority_skip": 3,
    "brand_context_window": 100,
    "code_context_window": 200
  },
  "scoring": {
    "brand_detection": {
      "keyword_match_weight": 4,
      "colon_match_weight": 1,
      "exact_match_weight": 15
    },
    "express_code": {
      "base_by_bbox_width": true,
      "dash_multiplier": 20,
      "letter_multiplier": 5
    },
    "food_code": {
      "base_by_bbox_width": true,
      "brand_overrides": {}
    }
  },
  "pickup_location": {
    "start_keywords": [],
    "target_keywords": [],
    "stop_keywords": [],
    "garbage_patterns": [
      "\\d{10,}"
    ],
    "proximity_threshold": 400,
    "store_name_bonus": 800,
    "store_name_max_len": 12,
    "trailing_labels": [],
    "sentence_patterns": [
      "((?:Amazon Locker|InPost Locker|DHL Packstation|UPS Access Point|FedEx OnSite|Hub Locker)\\s*[-–—:\\s]*[A-Za-z0-9\\s]{2,25})"
    ],
    "store_patterns": [
      "([\\p{L}\\p{N}]{2,20})"
    ],
    "road_patterns": [
      "(\\b\\d{1,5}\\s+[A-Za-z0-9\\s]{2,20}(?:Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Drive|Dr|Lane|Ln)\\b)"
    ],
    "transit_patterns": [
      "([\\p{L}\\p{N}]{2,15})"
    ],
    "business_hour_keywords": [
      "opening hours",
      "hours",
      "horário"
    ],
    "scoring": {
      "target_keyword_bonus": 20,
      "address_bonus": 1000,
      "address_fallback_bonus": 500,
      "address_fallback_min_length": 8,
      "loc_with_target_bonus": 100
    }
  }
}
